# =========================================================================
# RETINAX CARE — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# Health-a-thon 2026 Edition
# =========================================================================

# Environment Mode: development / production / staging
ENVIRONMENT=development
DEBUG=True

# Security Secret Key (Use a high-entropy string in production)
SECRET_KEY=retinax-care-super-secret-key-healthathon-2026-prod-grade
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Relational Database (PostgreSQL for production/Docker; SQLite fallback for local test)
# PostgreSQL in Docker:
DATABASE_URL=postgresql+psycopg2://retinax:retinax_secure_pass_2026@localhost:5432/retinax_care
# Local development fallback (without Docker):
# DATABASE_URL=sqlite:///data/retinax_care.db

POSTGRES_USER=retinax
POSTGRES_PASSWORD=retinax_secure_pass_2026
POSTGRES_DB=retinax_care

# Redis Message Broker & Celery Result Backend
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Document Storage: "local" (default filesystem) or "s3" (AWS S3 / MinIO)
STORAGE_BACKEND=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=retinax-care-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# MinIO Local Credentials (used in docker-compose)
MINIO_ROOT_USER=retinax_admin
MINIO_ROOT_PASSWORD=minio_secure_pass_2026

# Frontend Configuration
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://backend:8000
