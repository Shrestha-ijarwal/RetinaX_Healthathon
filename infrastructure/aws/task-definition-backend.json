{
  "family": "retinax-care-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::123456789012:role/retinaxEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/retinaxBackendTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "123456789012.dkr.ecr.ap-south-1.amazonaws.com/retinax-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "STORAGE_BACKEND", "value": "s3" },
        { "name": "AWS_S3_BUCKET", "value": "retinax-care-production-documents" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:retinax/db-url" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:retinax/redis-url" },
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:123456789012:secret:retinax/secret-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/retinax-care-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
